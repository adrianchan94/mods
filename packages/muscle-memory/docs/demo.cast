[0.902, "o", "\u001b[2m   ┌─ editing-letta-mods-safely/SKILL.md ──────────────────────────────────\u001b[0m\r\n\u001b[2m   │\u001b[0m ## Pitfalls (hard-won)\r\n"]
[0.281, "o", "\u001b[2m   │\u001b[0m - Tool args arrive via `ctx.args`, not positional: run(ctx){ const a = ctx.args }\r\n"]
[0.281, "o", "\u001b[2m   │\u001b[0m - Backups must NOT end in .ts — the loader double-registers them\r\n"]
[0.281, "o", "\u001b[2m   │\u001b[0m - A new tool isn't callable until /reload\r\n"]
[0.281, "o", "\u001b[2m   └────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[1.402, "o", "\r\n\u001b[36m▌ 5 · every skill is an evidence-backed git object\u001b[0m  \u001b[2mreferences/evidence/<ts>.json\u001b[0m\r\n"]
