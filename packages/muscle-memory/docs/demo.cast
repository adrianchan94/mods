[0.000, "o", "\u001b[2m   │\u001b[0m ---\r\n"]
[0.000, "o", "\u001b[2m   │\u001b[0m name: editing-letta-code-mods\r\n\u001b[2m   │\u001b[0m description: Use when editing, validating, or registering Letta Code mods — tool args, backups, reload, esbuild.\r\n"]
[0.000, "o", "\u001b[2m   │\u001b[0m ---\r\n"]
[0.000, "o", "\u001b[2m   │\u001b[0m ## When to use\r\n"]
[0.000, "o", "\u001b[2m   │\u001b[0m - editing/validating a Letta mod\r\n"]
[0.000, "o", "\u001b[2m   │\u001b[0m ## Procedure\r\n\u001b[2m   │\u001b[0m 1. Edit the mod `.ts`\r\n"]
[0.000, "o", "\u001b[2m   │\u001b[0m 2. Args via ctx.args: `run(ctx){ const args = ctx.args }`\r\n"]
[0.000, "o", "\u001b[2m   │\u001b[0m 3. `npx esbuild <mod>.ts --bundle --platform=node --format=esm`\r\n\u001b[2m   │\u001b[0m 4. /reload to register new tools\r\n\u001b[2m   │\u001b[0m ## Pitfalls\r\n\u001b[2m   │\u001b[0m - args arrive via ctx.args, NOT positional (\"unknown action\")\r\n"]
[0.000, "o", "\u001b[2m   │\u001b[0m - backups ending in .ts double-register — suffix them\r\n"]
[0.000, "o", "\u001b[2m   └──────────────────────────────────────────────────────\u001b[0m\r\n"]
