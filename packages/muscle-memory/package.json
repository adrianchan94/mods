{
  "name": "@letta-ai/muscle-memory",
  "version": "0.3.1",
  "description": "Letta Code mod: a self-evolving skill foundry. It distills class-level skills from cross-conversation recall, routes update-first via MemFS search, filters env-noise, learns failure defenses, and ships evidence manifests + visible review UI. Dogfooded against Hermes-style skill distillation with coverage/runtime receipts.",
  "author": "Adrian Chan",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "letta-package",
    "letta-mod",
    "letta-code",
    "agent-skills",
    "skill-learning",
    "self-improving-agents",
    "tool-use-mining",
    "experience-distillation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/letta-ai/mods.git",
    "directory": "packages/muscle-memory"
  },
  "files": [
    "README.md",
    "MOD.md",
    "LICENSE",
    "mods",
    "scripts",
    "docs",
    "FRONTIER-EVIDENCE.md",
    "DOGFOOD-LOG.md",
    "*-result.json",
    "HOMERUN-SCORECARD.md"
  ],
  "letta": {
    "manifestVersion": 1,
    "mods": [
      "./mods/index.ts"
    ],
    "capabilities": [
      "tools",
      "commands",
      "events.tools",
      "events.lifecycle",
      "ui.panels"
    ],
    "engines": {
      "lettaCodeCli": ">=0.27.18"
    }
  },
  "scripts": {
    "test": "npx --yes esbuild mods/index.ts --bundle --platform=node --format=esm --outfile=/tmp/muscle-memory-package-test.mjs && node scripts/validate.mjs && npm run integration && npm run autonomy",
    "demo": "npx --yes esbuild mods/index.ts --bundle --platform=node --format=esm --outfile=/tmp/muscle-memory-package-demo.mjs && node scripts/demo.mjs",
    "integration": "npx --yes esbuild mods/index.ts --bundle --platform=node --format=esm --outfile=/tmp/muscle-memory-package-integration.mjs && node scripts/integration.mjs",
    "hermes:parity": "node scripts/hermes-parity.mjs",
    "money-demo": "node scripts/money-demo.mjs",
    "live:defense": "node scripts/live-defense-correlation.mjs",
    "review:test": "node scripts/v31-review-test.mjs",
    "review:live": "node scripts/v31-live.mjs",
    "benchmark": "node scripts/benchmark-vs-hermes.mjs",
    "perf": "node scripts/perf-improvement.mjs",
    "demo:reel": "node scripts/demo-reel.mjs",
    "demo:record": "asciinema rec docs/demo.cast --overwrite -c 'node scripts/demo-reel.mjs' && agg --theme dracula --font-size 22 docs/demo.cast docs/demo.gif",
    "benchmark:multidomain": "node scripts/benchmark-multidomain.mjs",
    "benchmark:coverage": "node scripts/coverage-benchmark.mjs",
    "replicate": "node scripts/replicate-workflows.mjs",
    "runtime:crush": "node scripts/runtime-crush.mjs",
    "qa": "node scripts/qa-stress.mjs && node scripts/qa-stress2.mjs && node scripts/qa-stress3.mjs",
    "dogfood:kev-domain": "node scripts/kev-domain-dogfood.mjs",
    "final:gate": "node scripts/final-gate.mjs",
    "scorecard": "node scripts/scorecard.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "live:reload-proof": "node scripts/live-reload-proof.mjs",
    "dogfood:complete-loop": "node scripts/complete-loop-dogfood.mjs",
    "dogfood:separate-workflow": "node scripts/separate-workflow-dogfood.mjs",
    "dogfood:catalog-publish": "node scripts/catalog-publish-dogfood.mjs",
    "autonomy": "node scripts/autonomy.mjs"
  }
}
